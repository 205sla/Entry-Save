{
  "manifest_version": 3,
  "name": "Entry Save Manager",
  "version": "1.3.8",
  "minimum_chrome_version": "111",
  "description": "엔트리 작품의 '@' 변수/리스트 데이터를 로컬에 저장하고 불러오는 확장 프로그램",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Entry Save Manager",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ],
      "js": ["shared.js", "inject.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared.js", "inject.js"],
      "matches": [
        "https://playentry.org/*",
        "https://*.playentry.org/*"
      ]
    }
  ]
}
